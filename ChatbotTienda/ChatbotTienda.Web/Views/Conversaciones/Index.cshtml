@model IEnumerable<ChatbotTienda.Entidades.Conversacion>
@using ChatbotTienda.Entidades.Enums

@{
    ViewData["Title"] = "Mis Conversaciones";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Mis Conversaciones</h2>
            <p class="text-muted mb-0">Historial de consultas con el asistente de la tienda</p>
        </div>

        <form asp-action="Crear" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
                <span>+ Nueva conversación</span>
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4">
            <h4 class="fw-semibold">No tenés conversaciones activas</h4>
            
            <p class="text-muted">Iniciá una nueva charla con el bot para consultar dudas sobre pedidos, medios de pago y más.</p>
            
            <div class="mt-2">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary">
                        Comenzar primer chat
                    </button>
                </form>
            </div>
        </div>
    }
    else {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 border-top border-3 @ObtenerBordeEstado(item.Estado)">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-truncate mb-0" title="@item.Titulo">
                                    @item.Titulo
                                </h5>
                                
                                <span class="badge @ObtenerBadgeEstado(item.Estado)">
                                    @item.Estado
                                </span>
                            </div>

                            <p class="card-text text-muted small mt-2 mb-4">
                                Último mensaje: 
                                <strong>@item.FechaUltimoMensaje.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                            </p>

                            <div class="mt-auto">
                                <a asp-controller="Chat" asp-action="Index" asp-route-id="@item.Id" 
                                   class="btn btn-outline-primary w-100">
                                    @(item.Estado == EstadoConversacion.Activa ? "Continuar chat →" : "Ver historial →")
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    string ObtenerBadgeEstado(EstadoConversacion estado) => estado switch
    {
        EstadoConversacion.Activa => "bg-success",
        EstadoConversacion.Resuelta => "bg-secondary",
        EstadoConversacion.Derivada => "bg-warning text-dark",
        _ => "bg-info"
    };

    string ObtenerBordeEstado(EstadoConversacion estado) => estado switch
    {
        EstadoConversacion.Activa => "border-success",
        EstadoConversacion.Resuelta => "border-secondary",
        EstadoConversacion.Derivada => "border-warning",
        _ => "border-primary"
    };
}